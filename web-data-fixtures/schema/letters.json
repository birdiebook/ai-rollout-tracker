{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birdiebook.github.io/ai-rollout-tracker/schema/v1/letters.json",
  "title": "letters.json: index of the monthly letters and quarterly reports, newest first",
  "type": "object",
  "additionalProperties": false,
  "required": ["letters", "reports"],
  "properties": {
    "letters": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["month", "title", "kind", "file", "doc"],
      "properties": {"month": {"$ref": "common.json#/$defs/month"}, "month_sv": {"type": "string"}, "title": {"type": "string"},
                     "kind": {"type": "string"}, "file": {"type": "string"}, "doc": {"type": "string", "pattern": "^letters/\\d{4}-\\d{2}\\.json$"}}}},
    "reports": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["quarter", "title", "kind", "file", "doc"],
      "properties": {"quarter": {"type": "string", "pattern": "^\\d{4}Q[1-4]$"}, "quarter_sv": {"type": "string"}, "title": {"type": "string"},
                     "kind": {"type": "string"}, "file": {"type": "string"}, "doc": {"type": "string", "pattern": "^reports/\\d{4}Q[1-4]\\.json$"}}}}
  }
}
