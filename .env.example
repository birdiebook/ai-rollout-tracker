# Copy to .env (gitignored) and fill in. Never commit .env. In CI the same names are Actions secrets.
# SEC fair-access policy (and BLS: download.bls.gov, www.bls.gov): a declared User-Agent with a contact address,
# e.g. "ai-rollout-tracker you@example.com". A generic project identity, never personal data.
SEC_USER_AGENT=
# Free API keys (phase 2)
BLS_API_KEY=
EIA_API_KEY=
BEA_USER_ID=
FRED_API_KEY=
# Optional, in CI as Actions secrets when available (docs/drift.md)
CENSUS_API_KEY=
ECOS_API_KEY=
